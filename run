#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ $# -ne 1 ]]; then
	echo "Usage: ./run <simulation_dir>" >&2
	echo "Example: ./run simulations/simulation_01_yannick" >&2
	exit 1
fi

if [[ -x "$ROOT_DIR/ocean/bin/python" ]]; then
	exec "$ROOT_DIR/ocean/bin/python" "$ROOT_DIR/src/main.py" "$1"
fi

	exec python3 "$ROOT_DIR/src/main.py" "$1"