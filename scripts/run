#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

if [[ $# -ne 1 ]]; then
	echo "Usage: ./scripts/run <simulation_dir>" >&2
	echo "Example: ./scripts/run simulations/simulation_01_yannick" >&2
	exit 1
fi

cd "$ROOT_DIR/src"

if [[ -x "$ROOT_DIR/.env_ocean/bin/python" ]]; then
	exec "$ROOT_DIR/.env_ocean/bin/python" -m main "$1"
fi

exec python3 -m main "$1"